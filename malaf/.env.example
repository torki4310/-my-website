# انسخ هذا الملف إلى .env واملأ القيم. لا تضع ملف .env في المستودع (مُستثنى في .gitignore).

# --- الذكاء الاصطناعي (اختياري) ---
# بدونه يعمل الموقع في "وضع تجريبي" واضح: نصوصك كما هي مع عناوين جاهزة، بلا صياغة أو ترجمة.
ANTHROPIC_API_KEY=
# النموذج المستخدم (الافتراضي claude-opus-5-5)
AI_MODEL=claude-opus-5-5

# --- الجلسات (مطلوب في الإنتاج) ---
# سلسلة عشوائية طويلة، مثلًا: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# بدونها يُولَّد سرّ مؤقت وتسقط الجلسات (ويفقد المستخدمون الوصول لمسوداتهم) عند كل إعادة تشغيل.
SESSION_SECRET=

# --- الخادم ---
PORT=3000
# مجلد حفظ المشاريع والصور (يجب أن يكون دائمًا وغير عام)
DATA_DIR=./data
# اجعلها true عند التشغيل خلف HTTPS
COOKIE_SECURE=false
# اجعلها true إن كان الخادم خلف وكيل عكسي (nginx وغيره) لاحتساب عنوان IP الصحيح
TRUST_PROXY=false
# مسار Chromium مخصص لتصدير PDF (اختياري؛ الافتراضي متصفح Playwright المثبت)
CHROMIUM_PATH=

# --- الحدود ---
MAX_FILE_MB=5
MAX_FILES_PER_PROJECT=30
MAX_PROJECTS_PER_USER=20
GEN_LIMIT_PER_HOUR=20
GEN_LIMIT_PER_DAY=60
PDF_LIMIT_PER_HOUR=40
